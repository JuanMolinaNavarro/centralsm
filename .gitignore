# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# imágenes subidas (catálogo) cuando se corre en el host
/uploads

# backups locales de Postgres/uploads (los genera el servicio "backup" del compose)
/backups

# bot Playwright: sesión cacheada (cookies = sensible), reportes y capturas del inspector
/scripts/playwright/.auth
/scripts/playwright/resultados
/scripts/playwright/selectores-descubiertos.*
/playwright-report
/.playwright-mcp

# ---------------------------------------------------------------------------
# CentralSM — plantilla de variables de entorno.
# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Conexión a Postgres desde el HOST (prisma migrate, prisma studio, etc.).
# Docker sobreescribe esto para usar el host "db" en lugar de "localhost".
# Nota: el host expone Postgres en el puerto 5433 (ver docker-compose.yml).
DATABASE_URL="postgresql://centralsm:centralsm@localhost:5433/centralsm?schema=public"

# Credenciales del contenedor de Postgres (las usa docker-compose).
POSTGRES_USER="centralsm"
POSTGRES_PASSWORD="centralsm"
POSTGRES_DB="centralsm"

# Integración Teamplace / Finnegans (ver docs/API-Teamplace-Finnegans.md)
# Las keys se generan en Teamplace: Configuración → Seguridad → Usuarios → "Keys API".
TEAMPLACE_BASE_URL="https://api.finneg.com/api"
TEAMPLACE_TOKEN_URL="https://api.teamplace.finneg.com/api/oauth/token"
TEAMPLACE_CLIENT_ID=""
TEAMPLACE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Alta de productos en Finnegans Go por UI (bot Playwright)
# Lo procesa el microservicio worker (worker/README.md): la app solo encola el
# job en Postgres y el worker corre scripts/playwright/push-producto.ts.
# Ver docs/carga-productos-playwright.md
# ---------------------------------------------------------------------------
# Login del portal web (services.finneg.com). NO son las keys de la API.
FINNEGANS_USER=""
FINNEGANS_PASSWORD=""
FINNEGANS_WORKSPACE=""
FINNEGANS_LANG="Español"

# Vista del maestro de Productos (el viewID varía según workspace/empresa).
FINNEGANS_PRODUCTOS_URL="https://go.finneg.com/mas/vista?viewID=104"

# El bot corre headless por defecto. "false" abre el navegador (para depurar).
FINNEGANS_PUSH_HEADLESS="true"

# Ajustes opcionales del worker (defaults razonables, ver worker/README.md):
# WORKER_POLL_MS="4000"                 # intervalo de polling de la cola
# WORKER_JOB_TIMEOUT_MS="300000"        # timeout duro por job (5 min)
# FINNEGANS_PUSH_ESPERA_MS="2000"       # pausa entre acciones del form legacy
# FINNEGANS_STATE_PATH="scripts/playwright/.auth/finnegans-state.json"
# FINNEGANS_RESULTADOS_DIR="scripts/playwright/resultados"

# Autenticación de la app: password compartida del login y secreto de firma de la cookie.
# Generar el secreto con: openssl rand -hex 32
AUTH_PASSWORD=
AUTH_SECRET=

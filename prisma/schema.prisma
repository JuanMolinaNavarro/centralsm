// CentralSM — esquema de base de datos
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Operadores / usuarios del sistema interno.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nombre    String
  rol       Rol      @default(OPERADOR)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

enum Rol {
  ADMIN
  OPERADOR
  LECTOR
}

/// Categoría del catálogo. Es un árbol auto-referenciado: las "Categorías Macro"
/// son las raíces (parentId = null) y cada nivel aporta un `segmento` al SKU.
/// Ej.: Macro "IR" -> sub "1" -> sub "ADS" arma el código "#IR-1-ADS".
model Categoria {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  /// Fragmento que esta capa aporta al SKU (ej: "IR", "1", "ADS").
  segmento    String
  /// SKU completo acumulado desde la raíz, con "#" (ej: "#IR-1-ADS"). Único.
  codigoSku   String  @unique
  parentId    String?
  imagenUrl   String?
  orden       Int     @default(0)

  /// Última verificación manual (null = nunca verificada). Si después entran
  /// artículos (Producto.clasificadoAt > verificadaAt) queda "con cambios".
  verificadaAt  DateTime?
  /// Quién la verificó. Texto libre por ahora; cuando haya usuarios, agregar la
  /// FK y usar este campo como cache de display.
  verificadaPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Categoria?  @relation("CategoriaArbol", fields: [parentId], references: [id], onDelete: Cascade)
  children  Categoria[] @relation("CategoriaArbol")
  productos Producto[]

  // El fragmento debe ser único entre hermanos. (Para las raíces, la unicidad
  // real la garantiza codigoSku, ya que Postgres trata los NULL como distintos.)
  @@unique([parentId, segmento])
  @@index([parentId])

  caracteristicasFamilia CaracteristicaFamilia[]
}

/// Lápida de una categoría eliminada a propósito por el usuario: el sync diario
/// no vuelve a sembrar las categorías de la taxonomía cuyo codigoSku figure acá.
/// Crear a mano una categoría con el mismo codigoSku la revive (borra la lápida).
model CategoriaEliminada {
  id          String   @id @default(cuid())
  codigoSku   String   @unique
  nombre      String
  eliminadaAt DateTime @default(now())
}

/// Artículo del catálogo (hoja). Vive dentro de una categoría y recibe un
/// correlativo de 4 dígitos para formar su SKU (ej: "#IR-1-ADS-0001").
model Producto {
  id                 String         @id @default(cuid())
  categoriaId        String
  /// Correlativo dentro de la categoría (1, 2, 3...). Se formatea a 4 dígitos.
  secuencia          Int
  codigoSku          String         @unique
  nombre             String
  descripcion        String?
  imagenUrl          String?
  estado             EstadoProducto @default(ACTIVO)
  cantidadStock      Decimal        @default(0) @db.Decimal(18, 4)
  /// Total de stock del snapshot anterior (para el delta día a día del cron).
  cantidadStockAnterior Decimal     @default(0) @db.Decimal(18, 4)
  unidadStock        String         @default("UNI")
  lugar              String?
  fechaUltimoIngreso DateTime?

  /// Marcado por el cron cuando el producto apareció por primera vez.
  esNuevo      Boolean   @default(false)
  primeraVezAt DateTime?

  /// Última vez que se le asignó categoría (alta o movida manual). Sirve para
  /// detectar cambios posteriores a la verificación de la categoría.
  clasificadoAt DateTime @default(now())

  // Integración Teamplace — `teamplaceCodigo` es la llave del vínculo con el
  // maestro de productos de Teamplace (su `Codigo`). Único y opcional (los
  // artículos creados a mano no lo tienen). Para los productos dados de alta
  // desde CentralSM, este es el "Código" con el que se crean en Finnegans Go.
  teamplaceCodigo String?   @unique
  teamplaceSyncAt DateTime?

  // ─── Campos del maestro de Finnegans ────────────────────────────────────
  // Espejan 1:1 el formulario "Nuevo - Productos" de Finnegans Go (pestaña
  // General). Se usan para dar de alta el producto allá vía el bot Playwright.
  finnegansTipo       String   @default("Otros")
  finnegansPeso       Decimal  @default(0) @db.Decimal(18, 4)
  finnegansVolumen    Decimal  @default(0) @db.Decimal(18, 4)
  finnegansRubro      String?
  finnegansMarca      String?
  finnegansFamilia    String?
  finnegansSubFamilia String?
  finnegansActivo     Boolean  @default(true)
  esStockeable        Boolean  @default(false)
  seVende             Boolean  @default(false)
  seCompra            Boolean  @default(false)
  manejaRetenciones   Boolean  @default(false)

  // ─── Estado del push hacia Finnegans Go (bot Playwright) ────────────────
  // Los ~3200 productos que vinieron del pull quedan en NO_APLICA (no hay que
  // empujarlos); solo los creados desde CentralSM arrancan en PENDIENTE.
  finnegansPushEstado EstadoPushFinnegans @default(NO_APLICA)
  finnegansPushAt     DateTime?
  finnegansPushError  String?

  // ─── Ficha de investigación operativa ────────────────────────────────────
  // Campos del maestro que alimentan el cálculo de política de compra y
  // reposición (pestaña "Derivado" de la ficha). Ver src/lib/ficha.ts.
  /// 1 frena el servicio · 2 retrasa · 3 no afecta.
  criticidad        Int?
  /// Si pertenece a un kit (ej. "Instalación FTTH"), su demanda es derivada.
  kitNombre         String?
  /// Unidades que consume cada trabajo del kit, como mínimo.
  kitCantidad       Decimal?    @db.Decimal(18, 4)
  /// Artículo inactivo al que este reemplaza: las series de consumo se empalman.
  predecesorId      String?
  /// Intercambiables sin cambiar el servicio (texto libre).
  sustitutos        String?
  origen            OrigenArticulo?
  estadoItem        EstadoItem  @default(NUEVO)
  requiereAutoelevador Boolean  @default(false)
  /// Baterías, precintos, químicos. Null si no vence.
  vidaUtilMeses     Int?
  /// Ya comprado y viniendo; evita comprar dos veces.
  enTransito        Decimal     @default(0) @db.Decimal(18, 4)
  /// Trabajos proyectados por mes, para la demanda derivada del kit.
  instalacionesMes  Int?
  /// Qué pregunta contesta el costo unitario (para el ABC se usa reposición).
  tipoCosto         TipoCosto   @default(REPOSICION)
  /// Entidades habilitadas a operar el artículo.
  entidades         String?
  /// Proveedor cuyas condiciones (presentación, lote, precio) usa el cálculo.
  proveedorSeleccionadoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoria   Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  stock       StockDeposito[]
  historial   HistorialStock[]
  snapshots   SnapshotStock[]
  pushJobs    FinnegansPushJob[]

  predecesor Producto?  @relation("ArticuloPredecesor", fields: [predecesorId], references: [id], onDelete: SetNull)
  sucesores  Producto[] @relation("ArticuloPredecesor")

  proveedorSeleccionado ProveedorArticulo?  @relation("ProveedorSeleccionado", fields: [proveedorSeleccionadoId], references: [id], onDelete: SetNull)
  proveedores           ProveedorArticulo[]
  movimientos           MovimientoArticulo[]
  leadTimes             LeadTimeRegistro[]
  caracteristicas       CaracteristicaProducto[]

  @@unique([categoriaId, secuencia])
  @@index([categoriaId])
  @@index([categoriaId, clasificadoAt])
  @@index([nombre])
  @@index([finnegansPushEstado])
}

/// Tipo de característica del catálogo ("Potencia", "Frecuencia", "Conector").
/// Los crea el usuario a mano desde la ficha del artículo; son transversales a
/// todas las categorías (un mismo tipo se reusa en cualquier artículo).
model TipoCaracteristica {
  id String @id @default(cuid())
  /// Nombre visible, tal como lo escribió el usuario ("Potencia").
  nombre String
  /// Nombre normalizado (sin acentos ni separadores). Evita "Potencia"/"potencia".
  nombreClave String @unique
  /// Unidad sugerida al cargar el valor ("W", "GHz"). Se busca pegada al valor.
  unidad      String?
  descripcion String?
  orden       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  valores  CaracteristicaProducto[]
  familias CaracteristicaFamilia[]

  @@index([orden, nombre])
}

/// Tipo de característica asociado a una categoría ("familia"): todos los
/// artículos hermanos de esa categoría comparten el set de tipos, con valor
/// opcional por artículo. Se puebla al guardar una característica (el tipo se
/// asocia a la categoría del producto); quitar el tipo de la familia borra
/// también los valores cargados en los artículos de esa categoría.
model CaracteristicaFamilia {
  id          String   @id @default(cuid())
  categoriaId String
  tipoId      String
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  categoria Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  tipo      TipoCaracteristica @relation(fields: [tipoId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, tipoId])
  @@index([tipoId])
}

/// Valor de una característica para un artículo ("Potencia" -> "3 W").
/// El valor es texto libre: la búsqueda lo normaliza en la consulta.
model CaracteristicaProducto {
  id         String @id @default(cuid())
  productoId String
  tipoId     String
  valor      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producto Producto           @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo     TipoCaracteristica @relation(fields: [tipoId], references: [id], onDelete: Cascade)

  /// Un solo valor por tipo y artículo (si hace falta más de uno, va separado por comas).
  @@unique([productoId, tipoId])
  @@index([productoId])
  @@index([tipoId])
}

enum OrigenArticulo {
  NACIONAL
  IMPORTADO
}

enum EstadoItem {
  NUEVO
  RECORTE
  RECUPERADO
}

enum TipoCosto {
  /// Cuánto costaría volver a comprarlo hoy. El que usan el ABC y la sugerencia.
  REPOSICION
  /// El precio de la última orden pagada. Para auditar contra factura.
  ULTIMA_COMPRA
  /// Promedio de compras pesado por cantidad. Valoriza el stock existente.
  PROMEDIO_PONDERADO
  /// Valor fijo de administración. Para presupuestar, no para el ABC.
  ESTANDAR
}

/// Proveedor de un artículo con su presentación y condiciones de compra.
/// El mismo artículo puede venir en presentaciones distintas por proveedor;
/// la selección (Producto.proveedorSeleccionadoId) es la que usa el cálculo.
model ProveedorArticulo {
  id            String  @id @default(cuid())
  productoId    String
  nombre        String
  /// Cómo lo vende: caja, bolsa, bobina.
  unidadCompra  String  @default("unidad")
  /// Multiplicador: 1 unidad de compra = N unidades base. Caja x 100 → 100.
  factorCompra  Decimal @default(1) @db.Decimal(18, 4)
  /// Cómo sale del depósito hacia la operación.
  unidadConsumo String  @default("unidad")
  /// Multiplicador: 1 unidad de consumo = N unidades base.
  factorConsumo Decimal @default(1) @db.Decimal(18, 4)
  /// En unidad base. La sugerencia q nunca baja de esto.
  loteMinimo    Decimal @default(0) @db.Decimal(18, 4)
  /// El escalón por encima del mínimo, en unidad base.
  multiplo      Decimal @default(1) @db.Decimal(18, 4)
  orden         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producto        Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  precios         PrecioProveedor[]
  seleccionadoPor Producto[]        @relation("ProveedorSeleccionado")

  @@index([productoId])
}

/// Punto de la serie de precios de un proveedor (USD por unidad base).
/// El último precio del proveedor seleccionado es el costo unitario vigente.
model PrecioProveedor {
  id          String   @id @default(cuid())
  proveedorId String
  fecha       DateTime
  precioUsd   Decimal  @db.Decimal(18, 4)

  proveedor ProveedorArticulo @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId, fecha])
}

/// Movimiento de la ficha operativa, clasificado por tipo. Solo los CONSUMO
/// entran en la serie de demanda; el resto mueve stock pero no es demanda
/// (este es el campo que no existe en Finnegans).
model MovimientoArticulo {
  id         String         @id @default(cuid())
  productoId String
  fecha      DateTime
  tipo       TipoMovimiento
  /// Solo aplica a CONSUMO; separa la demanda pronosticable de la que distorsiona.
  demanda    TipoDemanda    @default(NA)
  /// En unidad base.
  solicitado Decimal        @default(0) @db.Decimal(18, 4)
  /// En unidad base. La serie suma lo ENTREGADO.
  entregado  Decimal        @default(0) @db.Decimal(18, 4)
  destino    String?
  /// N° de pedido/vale/remito. Enlaza salidas a proyecto con sus reingresos.
  pedido     String?
  /// Depósito de Finnegans donde impactó el movimiento (import del kardex).
  deposito   String?
  /// Empresa-sucursal del grupo a la que pertenece el movimiento.
  empresa    String?
  /// Documento del ERP que lo originó (ej: "REMVTA - 37007", "MIS - 8925").
  documento  String?
  /// null = cargado a mano en CentralSM; "KARDEX" = importado del informe de
  /// Ingresos y Egresos de Finnegans (el import borra y recarga esta fuente).
  fuente     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId, fecha])
  @@index([tipo])
  @@index([fuente])
}

enum TipoMovimiento {
  /// Salida real hacia instalación/servicio/venta. El único que es demanda.
  CONSUMO
  /// Cambio de depósito o sucursal (incluye remitos entre empresas del grupo).
  TRANSFERENCIA
  /// Material que vuelve al depósito. Excluida.
  DEVOLUCION
  /// Corrección por conteo físico. Excluida.
  AJUSTE
  /// Entrada por recepción de orden de compra (o producción). Excluida.
  RECEPCION_COMPRA
  /// Salida por devolución al proveedor. Excluida.
  DEVOLUCION_COMPRA
  /// Sale para un proyecto eventual con retorno esperado ("en calle").
  SALIDA_PROYECTO
  /// La vuelta (total o parcial) de una salida a proyecto, por el mismo pedido.
  REINGRESO_PROYECTO
}

enum TipoDemanda {
  /// Demanda normal del día a día: la única que sirve para pronosticar.
  RECURRENTE
  /// Pico puntual de un proyecto planificado; se aparta para no inflar el promedio.
  OBRA
  /// Pedido fuera de ciclo: marca dónde falló el stock.
  URGENTE
  /// No aplica (movimientos que no son consumo).
  NA
}

/// Lead time real de una recepción de orden de compra (días entre emisión y
/// recepción). El promedio y el desvío alimentan el stock de seguridad.
model LeadTimeRegistro {
  id         String   @id @default(cuid())
  productoId String
  dias       Int
  fecha      DateTime @default(now())

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
}

enum EstadoPushFinnegans {
  /// Vino del pull de Teamplace: ya existe allá, no hay nada que empujar.
  NO_APLICA
  PENDIENTE
  EN_PROCESO
  SINCRONIZADO
  ERROR
}

/// Una corrida del bot Playwright que empuja un producto a Finnegans Go.
/// Sirve de bitácora (reintentos, error, salida del runner) y para que la UI
/// haga polling del estado mientras el navegador trabaja.
model FinnegansPushJob {
  id         String              @id @default(cuid())
  productoId String
  estado     EstadoPushFinnegans @default(PENDIENTE)
  intento    Int                 @default(1)
  error      String?
  /// Salida (stdout/stderr) del runner, recortada.
  log        String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime            @default(now())

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@index([estado])
  @@index([createdAt])
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

/// Bitácora de cada corrida de sincronización diaria (cron o manual).
model SyncRun {
  id                 String   @id @default(cuid())
  ejecutadoAt        DateTime @default(now())
  tipo               TipoSync @default(CRON)
  ok                 Boolean  @default(true)
  error              String?
  duracionMs         Int?
  // Métricas del delta calculado en la corrida
  productosNuevos    Int      @default(0)
  productosConCambio Int      @default(0)
  unidadesAlta       Decimal  @default(0) @db.Decimal(18, 4)
  unidadesBaja       Decimal  @default(0) @db.Decimal(18, 4)
  stockRegistros     Int      @default(0)
  depositos          Int      @default(0)

  historial HistorialStock[]
  snapshots SnapshotStock[]

  @@index([ejecutadoAt])
}

enum TipoSync {
  CRON
  MANUAL
}

/// Histórico de cambios de stock detectados por cada corrida del cron, al
/// DETALLE por (producto, depósito). Guarda TODOS los movimientos (deltas) para
/// consultar por fecha, por depósito, y agregar entradas/salidas por tipo.
model HistorialStock {
  id         String   @id @default(cuid())
  syncRunId  String
  fecha      DateTime
  productoId String
  depositoId String
  antes      Decimal  @db.Decimal(18, 4)
  ahora      Decimal  @db.Decimal(18, 4)
  delta      Decimal  @db.Decimal(18, 4)

  syncRun  SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@index([productoId])
  @@index([depositoId])
}

/// Depósito físico/lógico. `codigo` espeja el depósito en Teamplace.
model Deposito {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock     StockDeposito[]
  historial HistorialStock[]
  snapshots SnapshotStock[]
}

/// Existencias de un producto en un depósito (modelo de reconciliación diaria).
/// `cantidadTeamplace` = Stock_1 (último snapshot traído del reporte de Teamplace).
/// `cantidad`          = Stock_F (stock de trabajo local = Stock_1 ± movimientos del día).
/// La diferencia (cantidad - cantidadTeamplace) es el neto a empujar al cierre.
model StockDeposito {
  id                String   @id @default(cuid())
  productoId        String
  depositoId        String
  cantidad          Decimal  @default(0) @db.Decimal(18, 4)
  cantidadTeamplace Decimal  @default(0) @db.Decimal(18, 4)
  snapshotAt        DateTime?
  stockMinimo       Decimal? @db.Decimal(18, 4)
  stockMaximo       Decimal? @db.Decimal(18, 4)
  puntoReposicion   Decimal? @db.Decimal(18, 4)
  updatedAt         DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Cascade)

  @@unique([productoId, depositoId])
  @@index([depositoId])
}

/// Serie temporal de NIVELES para investigación operativa: el snapshot completo
/// de cada corrida (una fila por (producto, depósito) con stock, aunque no haya
/// cambiado). A diferencia de HistorialStock (solo deltas), permite leer el
/// nivel absoluto de cualquier día sin integrar deltas hacia atrás.
/// ~4.300 filas/día ≈ 1,6 M filas/año: barato para lo que vale.
model SnapshotStock {
  id              String   @id @default(cuid())
  syncRunId       String
  fecha           DateTime
  productoId      String
  depositoId      String
  cantidad        Decimal  @db.Decimal(18, 4)
  puntoReposicion Decimal? @db.Decimal(18, 4)

  syncRun  SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  deposito Deposito @relation(fields: [depositoId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@index([productoId, fecha])
  @@index([depositoId, fecha])
}

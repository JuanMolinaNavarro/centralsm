# syntax=docker/dockerfile:1

# Imagen autocontenida del microservicio worker de Finnegans (worker/README.md).
# No monta el código por volumen: todo lo que necesita va adentro. Es la imagen
# que se despliega en Kubernetes (k8s/worker/deployment.yaml).
#
# Base oficial de Playwright: Node 22 + Chromium + libs del sistema ya resueltas
# (evita el `playwright install --with-deps` sobre slim, lento y frágil).
# ⚠️ El tag DEBE coincidir con la versión exacta de `playwright` en package.json
#    (por eso está fijada en "1.61.1", sin ^): browsers y librería van de la mano.
FROM mcr.microsoft.com/playwright:v1.61.1-noble

WORKDIR /app

# Dependencias (capa cacheada mientras no cambien package.json/lockfile).
# - npm install (no ci): el lockfile se genera en Windows y no registra las
#   deps opcionales solo-Linux (mismo motivo que el Dockerfile principal).
# - Instala también devDependencies A PROPÓSITO: tsx, playwright, dotenv y
#   prisma son devDeps pero el worker las necesita en runtime.
# - --ignore-scripts evita el postinstall de playwright: los browsers ya vienen
#   en la imagen (en $PLAYWRIGHT_BROWSERS_PATH).
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
  npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm config set fetch-timeout 600000 \
  && npm install --ignore-scripts --no-audit --no-fund

# Solo el código que el worker usa: el bot de Playwright y el loop de polling.
COPY prisma.config.ts tsconfig.json ./
COPY prisma ./prisma
COPY scripts/playwright ./scripts/playwright
COPY worker ./worker

# Cliente Prisma: src/generated está dockerignoreado, se genera acá
# (sale a /app/src/generated/prisma, como en dev).
RUN npx prisma generate

# Estado efímero del bot: sesión cacheada y capturas de errores. Se apunta a
# /data para montarlo como volumen (compose) o emptyDir (k8s); perderlo solo
# cuesta un re-login automático.
ENV FINNEGANS_STATE_PATH=/data/.auth/finnegans-state.json \
    FINNEGANS_RESULTADOS_DIR=/data/resultados \
    FINNEGANS_PUSH_HEADLESS=true
RUN mkdir -p /data/.auth /data/resultados && chown -R pwuser:pwuser /data

# pwuser viene en la imagen de Playwright; correr Chromium como root es mala idea.
USER pwuser

# tsx directo (sin npx en el medio): el proceso queda de PID 1 y recibe el
# SIGTERM de Docker/Kubernetes, del que depende el apagado prolijo del worker.
CMD ["node_modules/.bin/tsx", "worker/index.ts"]

# syntax=docker/dockerfile:1

# Imagen autocontenida del microservicio worker de Finnegans (worker/README.md).
#
# Versión SLIM (~1,5 GB vs 4,9 GB de la anterior): base node:22-slim + SOLO
# Chromium vía `playwright install --with-deps chromium`, y solo las
# dependencias que el worker usa de verdad (worker/package.json, no el
# package.json raíz que arrastra Next/React/Tailwind). Motivo: el servidor de
# producción tiene 19 GB de disco compartidos con otro sistema.
#
# ⚠️ La versión de `playwright` en worker/package.json DEBE coincidir con la
#    del package.json raíz (1.61.1 exacta): browsers y librería van de la mano.

FROM node:22-slim

WORKDIR /app

# openssl/ca-certificates para los engines de Prisma.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Browsers fuera de node_modules para que sobrevivan a reinstalls.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Dependencias mínimas del worker (capa cacheada mientras no cambie el json).
COPY worker/package.json ./package.json
RUN --mount=type=cache,target=/root/.npm \
  npm install --no-audit --no-fund

# Chromium + librerías de sistema que necesita (solo chromium, no ff/webkit).
RUN npx playwright install --with-deps chromium \
  && rm -rf /var/lib/apt/lists/*

# Solo el código que el worker usa: el bot de Playwright y el loop de polling.
COPY prisma.config.ts tsconfig.json ./
COPY prisma ./prisma
COPY scripts/playwright ./scripts/playwright
COPY worker ./worker

# Cliente Prisma (sale a /app/src/generated/prisma, como espera el código).
RUN npx prisma generate

# Estado efímero del bot: sesión cacheada y capturas de errores. Se apunta a
# /data para montarlo como volumen; perderlo solo cuesta un re-login automático.
ENV FINNEGANS_STATE_PATH=/data/.auth/finnegans-state.json \
    FINNEGANS_RESULTADOS_DIR=/data/resultados \
    FINNEGANS_PUSH_HEADLESS=true

# Correr Chromium como root es mala idea; usuario propio + permisos de /data.
RUN useradd -m pwuser \
  && mkdir -p /data/.auth /data/resultados \
  && chown -R pwuser:pwuser /data /ms-playwright
USER pwuser

# tsx directo (sin npx en el medio): el proceso queda de PID 1 y recibe el
# SIGTERM de Docker, del que depende el apagado prolijo del worker.
CMD ["node_modules/.bin/tsx", "worker/index.ts"]
